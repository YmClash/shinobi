# SHINOBI / Taijutsu — Variables d'environnement
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Copiez ce fichier en .env et adaptez les valeurs.

# — Fūinjutsu: PostgreSQL —
DATABASE_URL=postgres://shinobi:shinobi@localhost:5433/shinobi_dev

# — Fūinjutsu: Redis —
REDIS_URL=redis://127.0.0.1:6380

# — Observabilité —
RUST_LOG=info,taijutsu=debug,domain=debug,application=debug

# — VCS Workspace —
VCS_WORKSPACE_ROOT=./workspace

# — Ports serveur —
REST_PORT=3000
GRPC_PORT=50051
