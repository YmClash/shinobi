# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SHINOBI — .gitignore racine du projet
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ── Système d'exploitation ─────────────────
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ── Éditeurs & IDEs ────────────────────────
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# JetBrains (RustRover, IntelliJ, CLion)
.idea/
*.iws
*.iml
*.ipr
out/

# Vim / Neovim
[._]*.s[a-v][a-z]
!*.svg
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]
Session.vim
Viewsession.vim
.netrwhist
tags
[._]*.un~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# Sublime Text
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache
*.sublime-workspace
*.sublime-project

# ── Variables d'environnement ───────────────
# NE JAMAIS VERSIONNER LES SECRETS
.env
.env.*
!.env.example
!.env.template
*.env.local
*.env.development
*.env.staging
*.env.production
secrets/
*.pem
*.key
*.cert
*.p12
*.pfx

# ── Logs ───────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Temporaires ────────────────────────────
tmp/
temp/
.tmp/
*.tmp
*.bak
*.swp
*.orig

# ── Docker ─────────────────────────────────
# Garder les Dockerfile mais ignorer les overrides locaux
docker-compose.override.yml
.docker/

# ── Outils de développement ────────────────
# Direnv
.envrc

# ── Futures composantes SHINOBI ────────────
# Makimono (Frontend Next.js/Bun)
makimono/node_modules/
makimono/.next/
makimono/out/
makimono/build/
makimono/.bun/
makimono/dist/
makimono/.turbo/
makimono/.swc/
makimono/coverage/
makimono/.vercel/
# TypeScript / Build output
makimono/*.tsbuildinfo
makimono/**/*.js
makimono/**/*.js.map
makimono/**/*.d.ts
makimono/**/*.d.ts.map
!makimono/eslint.config.mjs
!makimono/next.config.ts
!makimono/tailwind.config.ts
!makimono/postcss.config.mjs

# Dojutsu (Prometheus / Grafana data)
dojutsu/data/
dojutsu/grafana/data/

# Nen (Kafka data)
nen/data/
nen/logs/

# Codex & Documentation locale
CODEX_BOARD.md
Docs/

# ── Workspace JJ ────────────────────────────
taijutsu/workspace
shinobi/.vscode

# -- Embeddings model --
taijutsu/.fastembed_cache
makimono/AGENTS.md
makimono/CLAUDE.md
